<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows 10 1809+ for toast notifications through the Windows SDK projections (Windows.UI.Notifications). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Lets macOS and Linux (CI) build this project; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Synchro.Core\Synchro.Core.csproj" />
  </ItemGroup>
</Project>
