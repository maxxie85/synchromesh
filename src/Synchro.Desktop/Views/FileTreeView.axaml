<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:Synchro.ViewModels.Details;assembly=Synchro.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Synchro.Desktop.Controls"
             x:Class="Synchro.Desktop.Views.FileTreeView"
             x:DataType="d:FilesViewModel">

  <!-- A torrent's files as a tree in a table: the rows are the visible tree (FilesViewModel.Rows: top-level nodes and
       the contents of open folders), the Name column draws the tree (indent, arrow, checkbox, icon). Sorting orders
       each folder's contents, folders first, so the tree stays intact. Used by the Files tab and the Add dialog; Done
       and Progress are hidden before adding (ShowsProgress), and so is Rename. Columns: GridColumns, code-behind. -->
  <UserControl.Styles>
    <Style Selector="ToggleButton.expander">
      <Setter Property="Theme" Value="{StaticResource MaterialIconButton}" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" />
    </Style>
    <Style Selector="CheckBox.wanted">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.priority">
      <Setter Property="Theme" Value="{StaticResource MaterialFlatButton}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialBodyBrush}" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
  </UserControl.Styles>

  <DataGrid x:Name="FileGrid" Classes="table" ItemsSource="{Binding Rows}" SelectionMode="Single">
    <DataGrid.Columns>
      <DataGridTemplateColumn Tag="Name" SortMemberPath="Name" Width="*" MinWidth="200">
        <DataGridTemplateColumn.Header>
          <controls:SortHeader Text="Name" Column="Name"
                               Sort="{Binding $parent[DataGrid].((d:FilesViewModel)DataContext).Sort}" />
        </DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="d:FileNodeViewModel">
            <!-- A DockPanel, not a horizontal StackPanel: the name (last child) gets the width that is left, so a long
                 name is cut off with "…" instead of running into the next column. -->
            <DockPanel HorizontalSpacing="4" VerticalAlignment="Center">
              <Border Width="{Binding Indent}" />
              <ToggleButton Classes="expander" IsVisible="{Binding IsFolder}" IsChecked="{Binding IsExpanded}"
                            ToolTip.Tip="Show or hide the folder's contents">
                <Panel>
                  <icons:MaterialIcon Kind="ChevronRight" IsVisible="{Binding !IsExpanded}" />
                  <icons:MaterialIcon Kind="ChevronDown" IsVisible="{Binding IsExpanded}" />
                </Panel>
              </ToggleButton>
              <Border Width="24" IsVisible="{Binding !IsFolder}" />
              <CheckBox Classes="wanted" IsChecked="{Binding IsWanted}" ToolTip.Tip="Download this" />
              <icons:MaterialIcon Kind="FolderOutline" Width="18" Height="18" Opacity="0.7" IsVisible="{Binding IsFolder}" />
              <icons:MaterialIcon Kind="FileOutline" Width="18" Height="18" Opacity="0.7" IsVisible="{Binding !IsFolder}" />
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding Path}" Margin="4,0,0,0" />
            </DockPanel>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>

      <DataGridTemplateColumn Tag="Size" SortMemberPath="SizeText" Width="90" MinWidth="60">
        <DataGridTemplateColumn.Header>
          <controls:SortHeader Text="Size" Column="Size" IsNumeric="True"
                               Sort="{Binding $parent[DataGrid].((d:FilesViewModel)DataContext).Sort}" />
        </DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="d:FileNodeViewModel">
            <TextBlock Classes="number" Text="{Binding SizeText}" VerticalAlignment="Center" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>

      <DataGridTemplateColumn Tag="Done" SortMemberPath="DoneText" Width="90" MinWidth="60">
        <DataGridTemplateColumn.Header>
          <controls:SortHeader Text="Done" Column="Done" IsNumeric="True"
                               Sort="{Binding $parent[DataGrid].((d:FilesViewModel)DataContext).Sort}" />
        </DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="d:FileNodeViewModel">
            <TextBlock Classes="number" Text="{Binding DoneText}" VerticalAlignment="Center" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>

      <DataGridTemplateColumn Tag="Progress" SortMemberPath="Progress" Width="160" MinWidth="90">
        <DataGridTemplateColumn.Header>
          <controls:SortHeader Text="Progress" Column="Progress"
                               Sort="{Binding $parent[DataGrid].((d:FilesViewModel)DataContext).Sort}" />
        </DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="d:FileNodeViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
              <ProgressBar Classes="status downloading" Minimum="0" Maximum="100" Value="{Binding Progress}"
                           VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding ProgressText}" FontSize="12"
                         MinWidth="34" TextAlignment="Right" />
            </Grid>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>

      <DataGridTemplateColumn Tag="Priority" SortMemberPath="PriorityText" Width="130" MinWidth="100">
        <DataGridTemplateColumn.Header>
          <controls:SortHeader Text="Priority" Column="Priority"
                               Sort="{Binding $parent[DataGrid].((d:FilesViewModel)DataContext).Sort}" />
        </DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="d:FileNodeViewModel">
            <Button Classes="priority" HorizontalAlignment="Left" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <TextBlock Text="{Binding PriorityText}" VerticalAlignment="Center" />
                <icons:MaterialIcon Kind="MenuDown" Width="18" Height="18" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="High" Command="{Binding SetPriorityCommand}"
                            CommandParameter="{x:Static d:PriorityOption.High}" />
                  <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}"
                            CommandParameter="{x:Static d:PriorityOption.Normal}" />
                  <MenuItem Header="Low" Command="{Binding SetPriorityCommand}"
                            CommandParameter="{x:Static d:PriorityOption.Low}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
