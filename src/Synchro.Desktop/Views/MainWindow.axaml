<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Synchro.ViewModels;assembly=Synchro.ViewModels"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:conv="clr-namespace:Synchro.Desktop.Converters"
        xmlns:views="clr-namespace:Synchro.Desktop.Views"
        xmlns:controls="clr-namespace:Synchro.Desktop.Controls"
        xmlns:settings="clr-namespace:Synchro.ViewModels.Settings;assembly=Synchro.ViewModels"
        xmlns:sort="clr-namespace:Synchro.Core.Settings;assembly=Synchro.Core"
        x:Class="Synchro.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Synchromesh"
        Icon="avares://Synchromesh/Assets/AppIcon.png"
        Width="1200" Height="800" MinWidth="1100" MinHeight="560">

  <!-- The menus: the macOS menu bar, and on Windows and Linux a menu bar inside the window (NativeMenuBar below).
       The app menu (About, Settings, Quit) is set on the Application in App.axaml; Windows and Linux have no app menu, so
       Settings… sits in Tools and Exit in Torrent there, and About
       is also in Help there. Shortcuts use Cmd on macOS and Ctrl elsewhere. No shortcuts that text fields also use
       (Cmd+Backspace, Cmd+arrows): native menu shortcuts win over the focused control. Paste stays a window key
       binding for the same reason. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="Torrent">
        <NativeMenu>
          <NativeMenuItem Header="Add…" Gesture="{OnPlatform Ctrl+O, macOS=Cmd+O}" Command="{Binding Toolbar.AddCommand}" />
          <NativeMenuItem Header="Add link from clipboard" Command="{Binding Toolbar.PasteCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Start" Gesture="{OnPlatform Ctrl+R, macOS=Cmd+R}" Command="{Binding Toolbar.StartCommand}" />
          <NativeMenuItem Header="Start now" Gesture="{OnPlatform Ctrl+Shift+R, macOS=Cmd+Shift+R}" Command="{Binding Toolbar.StartNowCommand}" />
          <NativeMenuItem Header="Stop" Gesture="{OnPlatform Ctrl+OemPeriod, macOS=Cmd+OemPeriod}" Command="{Binding Toolbar.StopCommand}" />
          <NativeMenuItem Header="Rename…" Command="{Binding Toolbar.RenameCommand}" />
          <NativeMenuItem Header="Labels…" Command="{Binding Toolbar.EditLabelsCommand}" />
          <NativeMenuItem Header="Move data…" Command="{Binding Toolbar.MoveDataCommand}" />
          <NativeMenuItem Header="Verify local data" Command="{Binding Toolbar.VerifyCommand}" />
          <NativeMenuItem Header="Ask trackers for more peers" Command="{Binding Toolbar.ReannounceCommand}" />
          <NativeMenuItem Header="Remove…" Command="{Binding Toolbar.RemoveCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Queue">
            <NativeMenu>
              <NativeMenuItem Header="Move to top" Command="{Binding Toolbar.MoveToTopCommand}" />
              <NativeMenuItem Header="Move up" Command="{Binding Toolbar.MoveUpCommand}" />
              <NativeMenuItem Header="Move down" Command="{Binding Toolbar.MoveDownCommand}" />
              <NativeMenuItem Header="Move to bottom" Command="{Binding Toolbar.MoveToBottomCommand}" />
            </NativeMenu>
          </NativeMenuItem>
          <!-- Windows and Linux have no app menu with Quit; Windows closes with Alt+F4 by itself, Linux uses Ctrl+Q. -->
          <NativeMenuItemSeparator IsVisible="{OnPlatform True, macOS=False}" />
          <NativeMenuItem Header="Exit" Gesture="{OnPlatform Linux=Ctrl+Q}" Click="OnExitMenuClick"
                          IsVisible="{OnPlatform True, macOS=False}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="All" Gesture="{OnPlatform Ctrl+D1, macOS=Cmd+D1}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[0].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.All}" />
          <NativeMenuItem Header="Downloading" Gesture="{OnPlatform Ctrl+D2, macOS=Cmd+D2}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[1].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Downloading}" />
          <NativeMenuItem Header="Seeding" Gesture="{OnPlatform Ctrl+D3, macOS=Cmd+D3}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[2].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Seeding}" />
          <NativeMenuItem Header="Paused" Gesture="{OnPlatform Ctrl+D4, macOS=Cmd+D4}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[3].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Paused}" />
          <NativeMenuItem Header="Errors" Gesture="{OnPlatform Ctrl+D5, macOS=Cmd+D5}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[4].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Errors}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Search" Gesture="{OnPlatform Ctrl+F, macOS=Cmd+F}" Click="OnSearchMenuClick" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Tools">
        <NativeMenu>
          <NativeMenuItem Header="Speed limits…" Command="{Binding Toolbar.SpeedLimitsCommand}" />
          <NativeMenuItem Header="Alternative speed limits" ToggleType="CheckBox" IsChecked="{Binding AltSpeed.IsEnabled}"
                          Command="{Binding AltSpeed.ToggleCommand}" />
          <NativeMenuItemSeparator />
          <!-- macOS has Settings… (Cmd+,) in the app menu; Windows and Linux get it here, with Ctrl+,. -->
          <NativeMenuItem Header="Settings…" Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"
                          IsVisible="{OnPlatform True, macOS=False}" />
          <NativeMenuItem Header="Servers…" Command="{Binding OpenSettingsCommand}" IsVisible="{OnPlatform False, macOS=True}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenu>
          <NativeMenuItem Header="Transmission website" Command="{Binding Help.OpenTransmissionWebsiteCommand}" />
          <NativeMenuItem Header="Transmission RPC specification" Command="{Binding Help.OpenRpcSpecificationCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="About Synchromesh" Command="{Binding Help.AboutCommand}"
                          IsVisible="{OnPlatform True, macOS=False}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Log UI stalls" ToggleType="CheckBox" IsChecked="{Binding Help.LogUiStalls, Mode=OneWay}"
                          Command="{Binding Help.ToggleUiStallLogCommand}" />
          <NativeMenuItem Header="Show the UI stall log" Command="{Binding Help.OpenUiStallLogFolderCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Window.KeyBindings>
    <!-- Paste a magnet link anywhere in the window. A focused text box still pastes into itself. -->
    <KeyBinding Gesture="{OnPlatform Ctrl+V, macOS=Cmd+V}" Command="{Binding Toolbar.PasteCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- Shows the menus above inside the window where there is no global menu bar (Windows, most Linux desktops);
         hidden on macOS. -->
    <NativeMenuBar DockPanel.Dock="Top" />

    <!-- App bar: the main action first, then actions on the selection, then search and server. -->
    <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource MaterialDividerBrush}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Command="{Binding Toolbar.AddCommand}" ToolTip.Tip="Add a torrent file or magnet link">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="Plus" Width="20" Height="20" />
            <TextBlock Text="Add" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="12,0,0,0">
          <Button Classes="bar" Command="{Binding Toolbar.StartCommand}" ToolTip.Tip="Start">
            <icons:MaterialIcon Kind="Play" />
          </Button>
          <Button Classes="bar" Command="{Binding Toolbar.StopCommand}" ToolTip.Tip="Stop">
            <icons:MaterialIcon Kind="Pause" />
          </Button>
          <Button Classes="bar" Command="{Binding Toolbar.RemoveCommand}" ToolTip.Tip="Remove…">
            <icons:MaterialIcon Kind="DeleteOutline" />
          </Button>
          <Rectangle Width="1" Height="24" Margin="6,0" Fill="{DynamicResource MaterialDividerBrush}" />
          <Button Classes="bar" ToolTip.Tip="Queue order">
            <icons:MaterialIcon Kind="FormatListNumbered" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Move to top" Command="{Binding Toolbar.MoveToTopCommand}" />
                <MenuItem Header="Move up" Command="{Binding Toolbar.MoveUpCommand}" />
                <MenuItem Header="Move down" Command="{Binding Toolbar.MoveDownCommand}" />
                <MenuItem Header="Move to bottom" Command="{Binding Toolbar.MoveToBottomCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="bar" Command="{Binding Toolbar.SpeedLimitsCommand}" ToolTip.Tip="Speed limits…">
            <icons:MaterialIcon Kind="Speedometer" />
          </Button>
          <!-- Turtle: the server's alternative speed limits. Shown filled and tinted while they're on. -->
          <ToggleButton Classes="bar turtle" IsChecked="{Binding AltSpeed.IsEnabled, Mode=OneWay}"
                        Command="{Binding AltSpeed.ToggleCommand}" ToolTip.Tip="{Binding AltSpeed.ToolTip}">
            <icons:MaterialIcon Kind="Turtle" />
          </ToggleButton>
        </StackPanel>

        <Border Grid.Column="3" Classes="search" Width="280" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" Classes="solo" Background="Transparent" VerticalAlignment="Center"
                   PlaceholderText="Search torrents" Text="{Binding TorrentList.SearchText}">
            <TextBox.InnerLeftContent>
              <icons:MaterialIcon Kind="Magnify" Width="20" Height="20" Margin="8,0,0,0" Opacity="0.6" />
            </TextBox.InnerLeftContent>
          </TextBox>
        </Border>
        <!-- Server menu: the connected server; pick another one, or manage the list in Settings. -->
        <Button x:Name="ServerMenuButton" Grid.Column="4" Classes="server" ToolTip.Tip="Switch server">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="ServerNetwork" Width="20" Height="20" />
            <TextBlock Text="{Binding Servers.ActiveServerName}" VerticalAlignment="Center" MaxWidth="180"
                       TextTrimming="CharacterEllipsis" />
            <icons:MaterialIcon Kind="MenuDown" Width="18" Height="18" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel MinWidth="240" Spacing="2" Margin="0,4">
                <ItemsControl ItemsSource="{Binding Servers.Servers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="settings:ServerItemViewModel">
                      <Button Classes="menu" Click="OnServerMenuItemClick"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Servers.ConnectCommand}"
                              CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                          <icons:MaterialIcon Kind="Check" Width="18" Height="18" IsVisible="{Binding IsActive}" />
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Classes="secondary" Text="{Binding Address}" FontSize="11" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="0,4" />
                <Button Classes="menu" Click="OnServerMenuItemClick" Command="{Binding OpenSettingsCommand}">
                  <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                    <icons:MaterialIcon Kind="Cog" Width="18" Height="18" />
                    <TextBlock Grid.Column="1" Text="Settings…" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="16,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource MaterialDividerBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <DockPanel HorizontalSpacing="8">
          <Ellipse Classes="dot"
                   Classes.connected="{Binding StatusBar.IsConnected}"
                   Classes.connecting="{Binding StatusBar.IsConnecting}"
                   Classes.warning="{Binding StatusBar.HasWarning}"
                   Classes.error="{Binding StatusBar.HasError}" />
          <TextBlock Text="{Binding StatusBar.Text}" FontSize="12" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusBar.Text}" />
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="16,0,0,0"
                    IsVisible="{Binding StatusBar.IsConnected}">
          <TextBlock Classes="secondary" Text="{Binding StatusBar.CountText}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusBar.DownloadSpeedText}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusBar.UploadSpeedText}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sidebar + torrent list -->
    <Grid ColumnDefinitions="240,*">
      <!-- Sidebar: filters on top; speed graph, storage and server-wide statistics pinned at the bottom (always visible). -->
      <Border Background="{DynamicResource SidebarBrush}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,12" Spacing="12">
            <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" Margin="0,0,0,-4">
              <Rectangle.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                  <Binding Path="Statistics.HasStatistics" />
                  <Binding Path="SpeedHistory.HasHistory" />
                </MultiBinding>
              </Rectangle.IsVisible>
            </Rectangle>

            <!-- Total speed over the last minutes; the scale's top value on the right of the header. -->
            <StackPanel Spacing="4" IsVisible="{Binding SpeedHistory.HasHistory}">
              <DockPanel HorizontalSpacing="8">
                <TextBlock DockPanel.Dock="Right" Classes="secondary" Text="{Binding SpeedHistory.ScaleText}" FontSize="11"
                           VerticalAlignment="Bottom" ToolTip.Tip="Top of the graph" />
                <TextBlock Classes="header" Text="SPEED" />
              </DockPanel>
              <controls:SpeedGraph Height="48" Samples="{Binding SpeedHistory.Samples}" Scale="{Binding SpeedHistory.Scale}"
                                   Window="{Binding SpeedHistory.Window}"
                                   DownloadBrush="{DynamicResource StatusDownloadingBrush}"
                                   UploadBrush="{DynamicResource StatusSeedingBrush}"
                                   GridBrush="{DynamicResource MaterialDividerBrush}" />
              <DockPanel HorizontalSpacing="8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedHistory.UploadText}" FontSize="12"
                           Foreground="{DynamicResource StatusSeedingBrush}" ToolTip.Tip="Upload, all torrents" />
                <TextBlock Text="{Binding SpeedHistory.DownloadText}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource StatusDownloadingBrush}" ToolTip.Tip="Download, all torrents" />
              </DockPanel>
            </StackPanel>

            <!-- Storage on the server's download disk -->
            <StackPanel Spacing="4" IsVisible="{Binding Storage.HasStorage}" ToolTip.Tip="{Binding Storage.Folder}">
              <TextBlock Classes="header" Text="STORAGE" />
              <ProgressBar Classes="status downloading" Minimum="0" Maximum="100" Value="{Binding Storage.UsedPercent}"
                           Classes.error="{Binding Storage.IsLow}" IsVisible="{Binding Storage.HasTotal}" Margin="0,2" />
              <TextBlock Text="{Binding Storage.Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                         Classes.error="{Binding Storage.IsLow}" />
              <TextBlock Classes="secondary" Text="{Binding Storage.TotalText}" FontSize="12"
                         IsVisible="{Binding Storage.HasTotal}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding Statistics.HasStatistics}">
              <Grid ColumnDefinitions="*,62,66" ColumnSpacing="6">
                <TextBlock Classes="header" Text="STATISTICS" />
                <TextBlock Grid.Column="1" Classes="header number" Text="Session" />
                <TextBlock Grid.Column="2" Classes="header number" Text="All time" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Statistics.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StatisticsRow">
                    <Grid ColumnDefinitions="*,62,66" ColumnSpacing="6" Margin="0,2">
                      <TextBlock Classes="secondary" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Label}" />
                      <TextBlock Grid.Column="1" Classes="number" Text="{Binding Current}" FontSize="12" />
                      <TextBlock Grid.Column="2" Classes="number" Text="{Binding Cumulative}" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <ScrollViewer>
            <StackPanel>
              <ListBox Classes="nav" ItemsSource="{Binding TorrentList.Filters}"
                       SelectedItem="{Binding TorrentList.SelectedFilter}" Margin="0,8">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FilterItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <icons:MaterialIcon Kind="{Binding Filter, Converter={x:Static conv:IconConverters.Filter}}"
                                          Width="20" Height="20" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Count}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Labels: narrow the list further, together with the status filter above. -->
              <StackPanel IsVisible="{Binding TorrentList.HasLabels}" Margin="0,0,0,8">
                <TextBlock Classes="header" Text="LABELS" Margin="24,4,0,4" />
                <ListBox Classes="nav" ItemsSource="{Binding TorrentList.LabelFilters}"
                         SelectedItem="{Binding TorrentList.SelectedLabel}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LabelFilterItemViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <icons:MaterialIcon Kind="TagMultipleOutline" Width="20" Height="20" IsVisible="{Binding IsAll}" />
                        <icons:MaterialIcon Kind="TagOutline" Width="20" Height="20" IsVisible="{Binding !IsAll}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Count}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- List on top, details of the selected torrent below; the splitter resizes the two. -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,300" MinHeight="0">
        <!-- Column headers: same column widths as the row template below. A click anywhere in a column's header (its
             whole width and height) sorts by that column, again: the other direction; the sorted one shows an arrow. Numbers are right-aligned, with the arrow before them. -->
        <Grid ColumnDefinitions="28,*,70,140,120,80,80,70,50" ColumnSpacing="12" Margin="16,0">
          <Button Grid.Column="0" Theme="{StaticResource SortHeaderButton}" HorizontalContentAlignment="Right"
                  Command="{Binding TorrentList.SortByCommand}" CommandParameter="{x:Static sort:TorrentSortColumn.Queue}"
                  ToolTip.Tip="Sort by queue order">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <icons:MaterialIcon Kind="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.Arrow}}" Width="16" Height="16"
                                  Foreground="{DynamicResource MaterialBodyLightBrush}"
                                  IsVisible="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.IsColumn}, ConverterParameter={x:Static sort:TorrentSortColumn.Queue}}" />
              <TextBlock Classes="header" Text="#" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Theme="{StaticResource SortHeaderButton}" HorizontalContentAlignment="Left"
                  Command="{Binding TorrentList.SortByCommand}" CommandParameter="{x:Static sort:TorrentSortColumn.Name}"
                  ToolTip.Tip="Sort by name">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Classes="header" Text="Name" VerticalAlignment="Center" />
              <icons:MaterialIcon Kind="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.Arrow}}" Width="16" Height="16"
                                  Foreground="{DynamicResource MaterialBodyLightBrush}"
                                  IsVisible="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.IsColumn}, ConverterParameter={x:Static sort:TorrentSortColumn.Name}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Theme="{StaticResource SortHeaderButton}" HorizontalContentAlignment="Right"
                  Command="{Binding TorrentList.SortByCommand}" CommandParameter="{x:Static sort:TorrentSortColumn.Size}"
                  ToolTip.Tip="Sort by size">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <icons:MaterialIcon Kind="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.Arrow}}" Width="16" Height="16"
                                  Foreground="{DynamicResource MaterialBodyLightBrush}"
                                  IsVisible="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.IsColumn}, ConverterParameter={x:Static sort:TorrentSortColumn.Size}}" />
              <TextBlock Classes="header" Text="Size" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Theme="{StaticResource SortHeaderButton}" HorizontalContentAlignment="Left"
                  Command="{Binding TorrentList.SortByCommand}" CommandParameter="{x:Static sort:TorrentSortColumn.Progress}"
                  ToolTip.Tip="Sort by progress">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Classes="header" Text="Progress" VerticalAlignment="Center" />
              <icons:MaterialIcon Kind="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.Arrow}}" Width="16" Height="16"
                                  Foreground="{DynamicResource MaterialBodyLightBrush}"
                                  IsVisible="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.IsColumn}, ConverterParameter={x:Static sort:TorrentSortColumn.Progress}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Theme="{StaticResource SortHeaderButton}" HorizontalContentAlignment="Left"
                  Command="{Binding TorrentList.SortByCommand}" CommandParameter="{x:Static sort:TorrentSortColumn.Status}"
                  ToolTip.Tip="Sort by status">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Classes="header" Text="Status" VerticalAlignment="Center" />
              <icons:MaterialIcon Kind="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.Arrow}}" Width="16" Height="16"
                                  Foreground="{DynamicResource MaterialBodyLightBrush}"
                                  IsVisible="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.IsColumn}, ConverterParameter={x:Static sort:TorrentSortColumn.Status}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="5" Theme="{StaticResource SortHeaderButton}" HorizontalContentAlignment="Right"
                  Command="{Binding TorrentList.SortByCommand}" CommandParameter="{x:Static sort:TorrentSortColumn.Download}"
                  ToolTip.Tip="Sort by download speed">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <icons:MaterialIcon Kind="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.Arrow}}" Width="16" Height="16"
                                  Foreground="{DynamicResource MaterialBodyLightBrush}"
                                  IsVisible="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.IsColumn}, ConverterParameter={x:Static sort:TorrentSortColumn.Download}}" />
              <TextBlock Classes="header" Text="Down" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="6" Theme="{StaticResource SortHeaderButton}" HorizontalContentAlignment="Right"
                  Command="{Binding TorrentList.SortByCommand}" CommandParameter="{x:Static sort:TorrentSortColumn.Upload}"
                  ToolTip.Tip="Sort by upload speed">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <icons:MaterialIcon Kind="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.Arrow}}" Width="16" Height="16"
                                  Foreground="{DynamicResource MaterialBodyLightBrush}"
                                  IsVisible="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.IsColumn}, ConverterParameter={x:Static sort:TorrentSortColumn.Upload}}" />
              <TextBlock Classes="header" Text="Up" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="7" Theme="{StaticResource SortHeaderButton}" HorizontalContentAlignment="Right"
                  Command="{Binding TorrentList.SortByCommand}" CommandParameter="{x:Static sort:TorrentSortColumn.Eta}"
                  ToolTip.Tip="Sort by time left">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <icons:MaterialIcon Kind="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.Arrow}}" Width="16" Height="16"
                                  Foreground="{DynamicResource MaterialBodyLightBrush}"
                                  IsVisible="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.IsColumn}, ConverterParameter={x:Static sort:TorrentSortColumn.Eta}}" />
              <TextBlock Classes="header" Text="ETA" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="8" Theme="{StaticResource SortHeaderButton}" HorizontalContentAlignment="Right"
                  Command="{Binding TorrentList.SortByCommand}" CommandParameter="{x:Static sort:TorrentSortColumn.Ratio}"
                  ToolTip.Tip="Sort by ratio">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <icons:MaterialIcon Kind="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.Arrow}}" Width="16" Height="16"
                                  Foreground="{DynamicResource MaterialBodyLightBrush}"
                                  IsVisible="{Binding TorrentList.Sort, Converter={x:Static conv:SortConverters.IsColumn}, ConverterParameter={x:Static sort:TorrentSortColumn.Ratio}}" />
              <TextBlock Classes="header" Text="Ratio" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <ListBox x:Name="TorrentListBox" Grid.Row="1" Classes="torrents"
                 ItemsSource="{Binding TorrentList.VisibleTorrents}"
                 SelectionMode="Multiple" AutoScrollToSelectedItem="False">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Start" Command="{Binding Toolbar.StartCommand}" />
              <MenuItem Header="Start now" Command="{Binding Toolbar.StartNowCommand}" />
              <MenuItem Header="Stop" Command="{Binding Toolbar.StopCommand}" />
              <MenuItem Header="Remove…" Command="{Binding Toolbar.RemoveCommand}" />
              <Separator />
              <MenuItem Header="Rename…" Command="{Binding Toolbar.RenameCommand}" />
              <MenuItem Header="Labels…" Command="{Binding Toolbar.EditLabelsCommand}" />
              <MenuItem Header="Move data…" Command="{Binding Toolbar.MoveDataCommand}" />
              <MenuItem Header="Verify local data" Command="{Binding Toolbar.VerifyCommand}" />
              <MenuItem Header="Ask trackers for more peers" Command="{Binding Toolbar.ReannounceCommand}" />
              <Separator />
              <MenuItem Header="Move to top" Command="{Binding Toolbar.MoveToTopCommand}" />
              <MenuItem Header="Move up" Command="{Binding Toolbar.MoveUpCommand}" />
              <MenuItem Header="Move down" Command="{Binding Toolbar.MoveDownCommand}" />
              <MenuItem Header="Move to bottom" Command="{Binding Toolbar.MoveToBottomCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TorrentItemViewModel">
              <Grid ColumnDefinitions="28,*,70,140,120,80,80,70,50" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Classes="number secondary" Text="{Binding QueueText}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
                  <icons:MaterialIcon Grid.Column="1" Kind="TagOutline" Width="14" Height="14" Opacity="0.6"
                                      IsVisible="{Binding HasLabels}" ToolTip.Tip="{Binding LabelsText}" />
                </Grid>
                <TextBlock Grid.Column="2" Classes="number" Text="{Binding SizeText}" VerticalAlignment="Center" />
                <Grid Grid.Column="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <ProgressBar Classes="status" Minimum="0" Maximum="100" Value="{Binding Progress}"
                               Classes.downloading="{Binding Status, Converter={x:Static conv:StatusConverters.IsDownloading}}"
                               Classes.seeding="{Binding Status, Converter={x:Static conv:StatusConverters.IsSeeding}}"
                               Classes.error="{Binding HasError}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding ProgressText}" FontSize="12"
                             MinWidth="34" TextAlignment="Right" />
                </Grid>
                <DockPanel Grid.Column="4" HorizontalSpacing="6" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding ErrorText}">
                  <icons:MaterialIcon Classes="status" IsVisible="{Binding !HasError}"
                                      Kind="{Binding Status, Converter={x:Static conv:IconConverters.Status}}"
                                      Classes.downloading="{Binding Status, Converter={x:Static conv:StatusConverters.IsDownloading}}"
                                      Classes.seeding="{Binding Status, Converter={x:Static conv:StatusConverters.IsSeeding}}" />
                  <icons:MaterialIcon Classes="status error" Kind="AlertCircleOutline" IsVisible="{Binding HasError}" />
                  <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Classes.error="{Binding HasError}" />
                </DockPanel>
                <TextBlock Grid.Column="5" Classes="number" Text="{Binding DownloadText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Classes="number" Text="{Binding UploadText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="7" Classes="number" Text="{Binding EtaText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="8" Classes="number" Text="{Binding RatioText}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="{Binding TorrentList.EmptyMessage}"
                   IsVisible="{Binding TorrentList.HasEmptyMessage}"
                   Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <GridSplitter Grid.Row="2" Height="1" ResizeDirection="Rows"
                      Background="{DynamicResource MaterialDividerBrush}" />
        <views:TorrentDetailsView Grid.Row="3" DataContext="{Binding Details}" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
