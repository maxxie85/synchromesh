<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Synchro.ViewModels;assembly=Synchro.ViewModels"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:conv="clr-namespace:Synchro.Desktop.Converters"
        xmlns:views="clr-namespace:Synchro.Desktop.Views"
        xmlns:controls="clr-namespace:Synchro.Desktop.Controls"
        xmlns:settings="clr-namespace:Synchro.ViewModels.Settings;assembly=Synchro.ViewModels"
        xmlns:sort="clr-namespace:Synchro.Core.Settings;assembly=Synchro.Core"
        x:Class="Synchro.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Synchromesh"
        Icon="avares://Synchromesh/Assets/AppIcon.png"
        Width="1200" Height="800" MinWidth="1100" MinHeight="560">

  <!-- The menus: the macOS menu bar, and on Windows and Linux a menu bar inside the window (NativeMenuBar below).
       The app menu (About, Settings, Quit) is set on the Application in App.axaml; Windows and Linux have no app menu, so
       Settings… sits in Tools and Exit in Torrent there, and About
       is also in Help there. Shortcuts use Cmd on macOS and Ctrl elsewhere. No shortcuts that text fields also use
       (Cmd+Backspace, Cmd+arrows): native menu shortcuts win over the focused control. Paste stays a window key
       binding for the same reason. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="Torrent">
        <NativeMenu>
          <NativeMenuItem Header="Add…" Gesture="{OnPlatform Ctrl+O, macOS=Cmd+O}" Command="{Binding Toolbar.AddCommand}" />
          <NativeMenuItem Header="Add link from clipboard" Command="{Binding Toolbar.PasteCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Start" Gesture="{OnPlatform Ctrl+R, macOS=Cmd+R}" Command="{Binding Toolbar.StartCommand}" />
          <NativeMenuItem Header="Start now" Gesture="{OnPlatform Ctrl+Shift+R, macOS=Cmd+Shift+R}" Command="{Binding Toolbar.StartNowCommand}" />
          <NativeMenuItem Header="Stop" Gesture="{OnPlatform Ctrl+OemPeriod, macOS=Cmd+OemPeriod}" Command="{Binding Toolbar.StopCommand}" />
          <NativeMenuItem Header="Rename…" Command="{Binding Toolbar.RenameCommand}" />
          <NativeMenuItem Header="Labels…" Command="{Binding Toolbar.EditLabelsCommand}" />
          <NativeMenuItem Header="Move data…" Command="{Binding Toolbar.MoveDataCommand}" />
          <NativeMenuItem Header="Verify local data" Command="{Binding Toolbar.VerifyCommand}" />
          <NativeMenuItem Header="Ask trackers for more peers" Command="{Binding Toolbar.ReannounceCommand}" />
          <NativeMenuItem Header="Remove…" Command="{Binding Toolbar.RemoveCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Queue">
            <NativeMenu>
              <NativeMenuItem Header="Move to top" Command="{Binding Toolbar.MoveToTopCommand}" />
              <NativeMenuItem Header="Move up" Command="{Binding Toolbar.MoveUpCommand}" />
              <NativeMenuItem Header="Move down" Command="{Binding Toolbar.MoveDownCommand}" />
              <NativeMenuItem Header="Move to bottom" Command="{Binding Toolbar.MoveToBottomCommand}" />
            </NativeMenu>
          </NativeMenuItem>
          <!-- Windows and Linux have no app menu with Quit; Windows closes with Alt+F4 by itself, Linux uses Ctrl+Q. -->
          <NativeMenuItemSeparator IsVisible="{OnPlatform True, macOS=False}" />
          <NativeMenuItem Header="Exit" Gesture="{OnPlatform Linux=Ctrl+Q}" Click="OnExitMenuClick"
                          IsVisible="{OnPlatform True, macOS=False}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="All" Gesture="{OnPlatform Ctrl+D1, macOS=Cmd+D1}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[0].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.All}" />
          <NativeMenuItem Header="Downloading" Gesture="{OnPlatform Ctrl+D2, macOS=Cmd+D2}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[1].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Downloading}" />
          <NativeMenuItem Header="Seeding" Gesture="{OnPlatform Ctrl+D3, macOS=Cmd+D3}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[2].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Seeding}" />
          <NativeMenuItem Header="Paused" Gesture="{OnPlatform Ctrl+D4, macOS=Cmd+D4}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[3].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Paused}" />
          <NativeMenuItem Header="Errors" Gesture="{OnPlatform Ctrl+D5, macOS=Cmd+D5}" ToggleType="Radio"
                          IsChecked="{Binding TorrentList.Filters[4].IsSelected}"
                          Command="{Binding TorrentList.SelectFilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Errors}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Search" Gesture="{OnPlatform Ctrl+F, macOS=Cmd+F}" Click="OnSearchMenuClick" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Tools">
        <NativeMenu>
          <NativeMenuItem Header="Speed limits…" Command="{Binding Toolbar.SpeedLimitsCommand}" />
          <NativeMenuItem Header="Alternative speed limits" ToggleType="CheckBox" IsChecked="{Binding AltSpeed.IsEnabled}"
                          Command="{Binding AltSpeed.ToggleCommand}" />
          <NativeMenuItemSeparator />
          <!-- macOS has Settings… (Cmd+,) in the app menu; Windows and Linux get it here, with Ctrl+,. -->
          <NativeMenuItem Header="Settings…" Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}"
                          IsVisible="{OnPlatform True, macOS=False}" />
          <NativeMenuItem Header="Servers…" Command="{Binding OpenSettingsCommand}" IsVisible="{OnPlatform False, macOS=True}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenu>
          <NativeMenuItem Header="Transmission website" Command="{Binding Help.OpenTransmissionWebsiteCommand}" />
          <NativeMenuItem Header="Transmission RPC specification" Command="{Binding Help.OpenRpcSpecificationCommand}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="About Synchromesh" Command="{Binding Help.AboutCommand}"
                          IsVisible="{OnPlatform True, macOS=False}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Log UI stalls" ToggleType="CheckBox" IsChecked="{Binding Help.LogUiStalls, Mode=OneWay}"
                          Command="{Binding Help.ToggleUiStallLogCommand}" />
          <NativeMenuItem Header="Show the UI stall log" Command="{Binding Help.OpenUiStallLogFolderCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Window.KeyBindings>
    <!-- Paste a magnet link anywhere in the window. A focused text box still pastes into itself. -->
    <KeyBinding Gesture="{OnPlatform Ctrl+V, macOS=Cmd+V}" Command="{Binding Toolbar.PasteCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- Shows the menus above inside the window where there is no global menu bar (Windows, most Linux desktops);
         hidden on macOS. -->
    <NativeMenuBar DockPanel.Dock="Top" />

    <views:ToolbarView x:Name="ToolbarPanel" DockPanel.Dock="Top" />

    <views:StatusBarView DockPanel.Dock="Bottom" DataContext="{Binding StatusBar}" />

    <!-- Sidebar + torrent list -->
    <Grid ColumnDefinitions="240,*">
      <views:SidebarView />

      <!-- List on top, details of the selected torrent below; the splitter resizes the two. -->
      <Grid Grid.Column="1" RowDefinitions="*,Auto,300" MinHeight="0">
        <views:TorrentListView x:Name="TorrentListPanel" />

        <GridSplitter Grid.Row="1" Height="1" ResizeDirection="Rows"
                      Background="{DynamicResource MaterialDividerBrush}" />
        <views:TorrentDetailsView Grid.Row="2" DataContext="{Binding Details}" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
