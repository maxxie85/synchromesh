<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Synchro.Desktop.Views.MessageWindow"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Classes="actions">
      <Button Content="OK" IsDefault="True" IsCancel="True" Click="OnOkClick" />
    </StackPanel>
  </StackPanel>
</Window>
