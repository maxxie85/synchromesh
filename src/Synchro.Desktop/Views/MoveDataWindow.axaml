<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Synchro.ViewModels;assembly=Synchro.ViewModels"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        x:Class="Synchro.Desktop.Views.MoveDataWindow"
        x:DataType="vm:MoveDataViewModel"
        Title="Move data"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Spacing="4">
      <TextBox Classes="outline" assists:TextFieldAssist.Label="Folder on the server" Text="{Binding Location}" />
      <TextBlock Classes="caption secondary" Text="{Binding CurrentLocation, StringFormat='Now in {0}'}" Margin="4,0"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <StackPanel Spacing="2">
      <ToggleSwitch Content="Move the files there" IsChecked="{Binding MoveFiles}" />
      <TextBlock Classes="caption secondary" TextWrapping="Wrap" Margin="48,0,0,0"
                 Text="Leave this off when the files are already in that folder (moved by hand): the server then only looks for them there." />
    </StackPanel>
    <StackPanel Classes="actions">
      <Button Theme="{StaticResource MaterialFlatButton}" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Content="Move" Command="{Binding MoveCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
